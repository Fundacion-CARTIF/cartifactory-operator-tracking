    {
      "id": 16,
      "title": "Estados de nodos y selección de manos",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_ORION}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_ORION}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  ts AS \"time\",\n  compound::jsonb ->> 'node_name' AS \"Nodo\",\n  compound::jsonb ->> 'mediapipe_state' AS \"MediaPipe\",\n  compound::jsonb ->> 'landmarks_3d_state' AS \"Landmarks 3D\",\n  compound::jsonb ->> 'palm_plane_state' AS \"Palm plane\",\n  compound::jsonb ->> 'cam_to_base_state' AS \"Cam to base\",\n  compound::jsonb ->> 'hand_selection' AS \"Selección de mano\",\n  compound::jsonb ->> 'tracked_hand_ids' AS \"IDs de manos\"\nFROM public.attributes\nWHERE entityid = 'urn:ngsi-ld:StatsHandPipeline:stats_hand_pipeline'\n  AND $__timeFilter(ts)\nORDER BY ts DESC\nLIMIT 50;",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
