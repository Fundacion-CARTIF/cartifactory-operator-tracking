          "rawSql": "SELECT\n  ts AS \"time\",\n  compound::jsonb -> 'header' AS \"Cabecera ROS\",\n  compound::jsonb ->> 'node_name' AS \"Nodo\",\n  compound::jsonb ->> 'tracked_hand_ids' AS \"IDs de manos\",\n  compound::jsonb ->> 'hand_selection' AS \"Selección de mano\"\nFROM public.attributes\nWHERE entityid = 'urn:ngsi-ld:StatsHandPipeline:stats_hand_pipeline'\n  AND $__timeFilter(ts)\nORDER BY ts DESC\nLIMIT 20;",
          "refId": "A"
