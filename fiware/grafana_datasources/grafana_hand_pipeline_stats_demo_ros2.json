          "rawSql": "SELECT\n  ts AS \"time\",\n  (compound::jsonb ->> 'action_goals_received')::integer AS \"Recibidos\",\n  (compound::jsonb ->> 'action_goals_accepted')::integer AS \"Aceptados\",\n  (compound::jsonb ->> 'action_goals_rejected')::integer AS \"Rechazados\",\n  (compound::jsonb ->> 'action_goals_canceled')::integer AS \"Cancelados\",\n  (compound::jsonb ->> 'action_goals_succeeded')::integer AS \"Completados\",\n  (compound::jsonb ->> 'action_goals_failed')::integer AS \"Fallidos\"\nFROM public.attributes\nWHERE entityid = 'urn:ngsi-ld:StatsHandPipeline:stats_hand_pipeline'\n  AND $__timeFilter(ts)\nORDER BY ts ASC;",
