        "content": "<div style=\"display:flex; align-items:center; gap:40px;\">\n  <img src=\"https://arise-middleware.eu/wp-content/uploads/2024/03/logo-arise.png\" alt=\"ARISE\" style=\"height:80px;\">\n  <img src=\"https://www.cartif.es/wp-content/uploads/2025/08/cartiflogo-transparentbg1-1024x453.png\" alt=\"CARTIF\" style=\"height:150px;\">\n</div>\n\n<h1>Hand Pipeline — Stats</h1>\n<hr>\n\n<p>Estadísticas del pipeline ROS 2 registradas por Orion-LD en TimescaleDB</p>",
        "mode": "html"
      },
      "pluginVersion": "11.4.0",
      "title": "",
      "transparent": true,
      "type": "text"
    },
    {
      "id": 2,
      "title": "Cámara disponible",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_ORION}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_ORION}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  ts AS \"time\",\n  CASE\n    WHEN lower(compound::jsonb ->> 'camera_available') IN ('true','1') THEN 1\n    WHEN lower(compound::jsonb ->> 'camera_available') IN ('false','0') THEN 0\n    ELSE NULL\n  END AS \"value\"\nFROM public.attributes\nWHERE entityid = 'urn:ngsi-ld:StatsHandPipeline:stats_hand_pipeline'\n  AND $__timeFilter(ts)\nORDER BY ts DESC\nLIMIT 1;",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "SÍ",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
