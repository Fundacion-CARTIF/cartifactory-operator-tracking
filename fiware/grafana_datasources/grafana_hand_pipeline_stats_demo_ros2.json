      "options": {
        "mode": "markdown",
        "content": "## Demo ROS 2 · Orion-LD · TimescaleDB\nLecturas de `/demo/entero` (2 s), `/demo/booleano` (5 s) y `/demo/color` (4 s). Valores extraídos de `compound.data`. Los indicadores muestran la última muestra del intervalo seleccionado."
      },
      "pluginVersion": "11.4.0"
    },
    {
      "id": 20,
      "title": "Entero actual · /demo/entero",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_ORION}"
      },
      "description": "Valor actual Int32 (0 a 9). Publicación prevista cada 2 s.",
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_ORION}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (compound::jsonb ->> 'data')::integer AS \"Entero\"\nFROM public.attributes\nWHERE entityid = 'urn:ngsi-ld:DemoEntero:demo_entero'\n  AND $__timeFilter(ts)\n  AND compound IS NOT NULL\n  AND compound::jsonb ? 'data'\nORDER BY ts DESC\nLIMIT 1;",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "max": 9
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      }
    },
    {
      "id": 21,
      "title": "Booleano actual · /demo/booleano",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_ORION}"
      },
      "description": "Muestra el literal true o false, sin convertirlo a 1/0.",
      "gridPos": {
        "x": 8,
        "y": 52,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_ORION}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  CASE compound::jsonb ->> 'data'\n    WHEN 'true' THEN 1\n    WHEN 'false' THEN 0\n    ELSE NULL\n  END AS \"Booleano\"\nFROM public.attributes\nWHERE entityid = 'urn:ngsi-ld:DemoBooleano:demo_booleano'\n  AND $__timeFilter(ts)\n  AND compound IS NOT NULL\n  AND compound::jsonb ? 'data'\nORDER BY ts DESC\nLIMIT 1;",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "false",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "true",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      }
    },
    {
      "id": 22,
      "title": "Color actual · /demo/color",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_ORION}"
      },
      "description": "Último color publicado en std_msgs/msg/String.",
      "gridPos": {
        "x": 16,
        "y": 52,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_ORION}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  CASE compound::jsonb ->> 'data'\n    WHEN 'rojo' THEN 1\n    WHEN 'verde' THEN 2\n    WHEN 'azul' THEN 3\n    WHEN 'amarillo' THEN 4\n    WHEN 'naranja' THEN 5\n    ELSE NULL\n  END AS \"Color\"\nFROM public.attributes\nWHERE entityid = 'urn:ngsi-ld:DemoColor:demo_color'\n  AND $__timeFilter(ts)\n  AND compound IS NOT NULL\n  AND compound::jsonb ? 'data'\nORDER BY ts DESC\nLIMIT 1;",
          "refId": "A"
        }
      ],
      "transparent": false,
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
